-- =====================================================================
-- A2 - Salary Review (uses GOTO as a "continue")
-- For each employee:
--   * < 1 year of service         -> not eligible, skip
--   * monthly salary >= 1,000,000 -> already at cap, skip
--   * >= 5 years -> 10% raise, otherwise 5% raise
-- GOTO next_employee jumps to the end of the loop body (skip the rest).
-- =====================================================================
SET SERVEROUTPUT ON

DECLARE
    v_years      NUMBER;
    v_raise_pct  NUMBER;
    v_new_salary NUMBER;
BEGIN
    DBMS_OUTPUT.PUT_LINE('========== SALARY REVIEW ==========');

    FOR rec IN (SELECT emp_id,
                       first_name || ' ' || last_name AS full_name,
                       hire_date,
                       monthly_salary
                FROM   employees
                ORDER  BY emp_id)
    LOOP
        v_years := FLOOR(MONTHS_BETWEEN(SYSDATE, rec.hire_date) / 12);

        IF v_years < 1 THEN
            DBMS_OUTPUT.PUT_LINE(rec.emp_id || ' ' || rec.full_name ||
                                 ': NOT ELIGIBLE (less than 1 year of service)');
            GOTO next_employee;
        END IF;

        IF rec.monthly_salary >= 1000000 THEN
            DBMS_OUTPUT.PUT_LINE(rec.emp_id || ' ' || rec.full_name ||
                                 ': AT SALARY CAP - no raise');
            GOTO next_employee;
        END IF;

        IF v_years >= 5 THEN
            v_raise_pct := 10;
        ELSE
            v_raise_pct := 5;
        END IF;

        v_new_salary := rec.monthly_salary * (1 + v_raise_pct / 100);

        DBMS_OUTPUT.PUT_LINE(rec.emp_id || ' ' || rec.full_name || ': ' ||
                             v_years || ' yrs, +' || v_raise_pct || '% -> ' ||
                             TO_CHAR(rec.monthly_salary, 'FM999,999,990') || ' to ' ||
                             TO_CHAR(v_new_salary,       'FM999,999,990'));

        <<next_employee>>
        NULL;   -- a label must be followed by a statement
    END LOOP;

    DBMS_OUTPUT.PUT_LINE('========== REVIEW COMPLETE ==========');
END;
/
